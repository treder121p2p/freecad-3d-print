# ============================================
# FreeCAD 3D Print — Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# Polza API key for MiMo AI (required)
# Get yours at: https://polza.ai
POLZA_API_KEY=your_key_here

# AI Model (default: xiaomi/mimo-v2.5 via Polza)
POLZA_MODEL=xiaomi/mimo-v2.5

# Web UI port (main interface: screen + chat)
WEBUI_PORT=9876

# FreeCAD RPC port (API access)
RPC_PORT=9875

# noVNC port (direct VNC access, optional)
NOVNC_PORT=6080
