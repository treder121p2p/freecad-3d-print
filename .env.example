# FreeCAD AI Bridge — Environment Configuration
# Copy this file to .env and fill in your values

# Required: Polza API key (get yours at https://polza.ai)
POLZA_API_KEY=your_api_key_here

# Optional: AI model (default: xiaomi/mimo-v2.5)
# Available: xiaomi/mimo-v2.5 (cheap), xiaomi/mimo-v2.5-pro (strong)
POLZA_MODEL=xiaomi/mimo-v2.5

# Optional: ports
WEBUI_PORT=9876
RPC_PORT=9875
BRIDGE_PORT=9877
NOVNC_PORT=6080

# Optional: CORS origin (default: *)
CORS_ORIGIN=*

# Optional: feedback features
ENABLE_SCREENSHOT=1
ENABLE_LOG_FEEDBACK=1
MAX_RETRIES=2
